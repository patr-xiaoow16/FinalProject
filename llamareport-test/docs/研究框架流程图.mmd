%% LlamaReport 研究框架流程图 - Mermaid 源文件
%% 可在 https://mermaid.live 或支持 Mermaid 的编辑器中打开渲染

flowchart TB
    subgraph 用户与前端
        A[用户上传 PDF/Excel] --> B[用户触发处理]
        B --> C[文档处理]
        U[用户提问 / 点击章节 / 点击视图] --> Q[提问 / 报告 / 视图联动]
    end

    subgraph 文档与索引
        C --> D[文档解析]
        D --> E[表格抽取]
        E --> F[构建向量索引]
        F --> G[(向量库)]
    end

    subgraph 查询与报告
        Q --> H{请求类型?}
        H -->|问答| I[RAG 检索]
        H -->|报告/章节| J[报告 Agent]
        I --> G
        J --> K[基础问答 / 章节生成工具]
        K --> I
        K --> L[财务点评 / 业绩指引 / 业务亮点 / 投资策略 / 杜邦]
        L --> M[图表生成]
        M --> N[返回回答与图表]
    end

    subgraph 视图联动
        Q -->|点击视图| O[视图联动]
        O --> P[生成视图摘要]
        P --> R[联动生成引擎]
        R --> S[步骤1–3: 上下文 / 意图 / 关系类型]
        S --> T[步骤3.5: 领域知识检索]
        T --> DK[(领域知识库)]
        T --> V[步骤4: 生成联动查询]
        V --> W[数据检索与验证]
        W --> G
        W --> X[新视图生成]
        X --> Y[新视图列表与综合洞察]
    end

    A -.-> C
    U -.-> Q

---
%% ========== Query 流程（细化）==========
flowchart TB
    subgraph 入口
        A[用户提交问题] --> B[校验问题与长度]
        B --> C[获取检索引擎]
    end

    subgraph RAG查询
        C --> D[执行检索]
        D --> D1{索引已就绪?}
        D1 -->|否| D2[尝试加载已有索引]
        D2 --> D3{加载成功?}
        D3 -->|否| ERR[返回错误: 请先处理文档]
        D3 -->|是| D4[查询增强: 指令与指标强调]
        D1 -->|是| D4
        D4 --> D5{混合检索可用?}
        D5 -->|是| D6[混合检索]
        D6 --> D7[表格优先拼上下文]
        D7 --> D8[大模型生成回答]
        D8 --> D9[提取数据来源]
        D5 -->|否| D10[向量检索与过滤]
        D10 --> D11[检索并拼上下文]
        D11 --> D12[提取并过滤来源]
        D9 --> R1[得到回答与来源]
        D12 --> R1
    end

    subgraph 响应与可视化
        R1 --> R2{检索是否报错?}
        R2 -->|是| R3[返回错误提示]
        R2 -->|否| R4[组装回答与来源]
        R4 --> R5{用户勾选生成图表?}
        R5 -->|是| R6[可视化模块生成图表]
        R6 --> R7[写入图表配置]
        R5 -->|否| R8[返回响应]
        R7 --> R8
    end

---
%% ========== ReportAgent 流程（细化）==========
flowchart TB
    subgraph 入口
        E1[Agent 问答] --> Q[报告 Agent 查询]
        E2[单章节生成] --> S[单章节流程]
        E3[完整报告] --> R[完整报告流程]
    end

    subgraph 查询主流程
        Q --> Q1{查询类型}
        Q1 -->|通用| Q2[问题增强: 通用查询模式提示]
        Q1 -->|章节| Q2
        Q2 --> Q3[运行 Agent]
        Q3 --> Q4[流式事件: 工具调用与返回]
    end

    subgraph 工具结果收集
        Q4 --> T1[工具调用: 记录名称与参数]
        Q4 --> T2[工具返回: 规范化处理]
        T2 --> T3{工具类型}
        T3 -->|基础年报问答| T4[提取数据来源]
        T3 -->|财务点评| T5[提取摘要与表格 → 图表数据]
        T3 -->|业绩指引/业务亮点等| T6[提取摘要或结论 → 覆盖主回答]
        T3 -->|投资策略/杜邦| T6
        T3 -->|图表生成| T7[保存图表配置]
        T4 --> T8[记入工具调用列表]
        T5 --> T8
        T6 --> T8
        T7 --> T8
    end

    subgraph 响应组装
        T8 --> Q5[等待 Agent 结束]
        Q5 --> Q6[取主回答与摘要覆盖]
        Q6 --> Q7[补全数据来源说明]
        Q7 --> Q8{已有图表配置?}
        Q8 -->|有| Q9[写入响应图表]
        Q8 -->|无且通用模式有数据| Q10[补调图表生成]
        Q8 -->|否| Q11
        Q9 --> Q11[组装响应: 回答、来源、工具列表、图表、耗时]
        Q10 --> Q11
    end

    subgraph 单章节生成
        S --> S1{章节类型}
        S1 -->|财务点评/业绩指引/业务亮点| S2[对应章节工具或查询管线]
        S1 -->|投资策略| S3[投资策略工具]
        S2 --> S4[可补可视化]
        S3 --> S4
    end

    subgraph 完整报告
        R --> R1[Agent 按规则选工具与顺序]
    end
